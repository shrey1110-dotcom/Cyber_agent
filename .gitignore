__pycache__/
*.py[cod]
.pytest_cache/
.venv/
build/
dist/
*.egg-info/
audit.jsonl
.DS_Store

# Generated training-data artifacts. Keep only directory sentinels in Git.
data/raw/*
!data/raw/.gitkeep
data/extracted/*
!data/extracted/.gitkeep
data/cleaned/*
!data/cleaned/.gitkeep
data/rejected/*
!data/rejected/.gitkeep
data/manifests/*
!data/manifests/.gitkeep
data/splits/*
!data/splits/.gitkeep
data/reports/*
!data/reports/.gitkeep
data/downloads/*
!data/downloads/.gitkeep
data/sources/*
!data/sources/.gitkeep
data/generated/*
!data/generated/.gitkeep

# Generated tokenizer candidates and explicitly exported local finals.
artifacts/tokenizers/candidates/*
!artifacts/tokenizers/candidates/.gitkeep
artifacts/tokenizers/final/*
!artifacts/tokenizers/final/.gitkeep
artifacts/tokenizers/comparison_report.json
artifacts/datasets/snapshots/*
!artifacts/datasets/snapshots/.gitkeep
